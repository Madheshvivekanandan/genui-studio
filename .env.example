# Copy this file to .env.local and paste your key after the = sign.
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.5-flash).
# If you get "high demand" (503) errors, try another, e.g. gemini-flash-lite-latest
# GEMINI_MODEL=gemini-3.5-flash
